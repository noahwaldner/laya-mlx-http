# Local dev config for `ctl.sh` (flags to `laya-mlx-serve` override these).
LAYA_MLX_HOST=127.0.0.1
LAYA_MLX_PORT=8000
LAYA_MLX_MODEL_ID=aac6fef/laya-mlx
LAYA_MLX_DTYPE=float16
READY_TIMEOUT=300

# To serve your LAN instead, uncomment and set a long random key:
# LAYA_MLX_HOST=0.0.0.0
# LAYA_MLX_API_KEY=change-me

# The npm provider reads these on the *client* machine (optional, defaults shown):
# LAYA_MLX_BASE_URL=http://127.0.0.1:8000
